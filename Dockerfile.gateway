FROM golang:1.22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache ca-certificates
# Copy module files + pre-vendored dependencies — no network access needed
COPY go.mod go.sum ./
COPY vendor/ vendor/
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -ldflags="-w -s" -o nexus-gateway ./cmd/gateway

FROM alpine:3.19
RUN apk add --no-cache ca-certificates wget
WORKDIR /app
COPY --from=builder /app/nexus-gateway .
EXPOSE 8080 9090
ENTRYPOINT ["./nexus-gateway"]
